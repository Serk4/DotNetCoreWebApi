{
  "AiAgent": {
    "OpenAI": {
      /*
        ApiKey   – your OpenAI secret key (sk-…).
                   On Render.com set this as an environment variable:
                   AIAGENT__OPENAI__APIKEY=sk-…
        ModelId  – the chat-completion model to use.
                   Recommended: "gpt-4o" or "gpt-4-turbo".
        For Azure OpenAI, replace these two keys with:
          "Endpoint": "https://<resource>.openai.azure.com/",
          "DeploymentName": "<deployment-name>"
        and update Program.cs accordingly.
      */
      "ApiKey": "",
      "ModelId": "gpt-4o"
    },
    /*
      How often the auditor wakes up and checks for work (in seconds).
      60 s is a sensible production default; use a shorter value in dev.
    */
    "PollingIntervalSeconds": 60,
    /*
      How far back the auditor looks for "recently updated" worksheets.
      Worksheets whose StartAt is within this window will be audited.
    */
    "LookbackHours": 24
  },
  "ConnectionStrings": {
    /*
      Used as a fallback when the DATABASE_URL environment variable is not set.
      On Render.com the main Web API sets DATABASE_URL, so this agent reads it
      the same way (see Program.cs).  Populate this entry for local development.
      Example: "Host=localhost;Port=5432;Database=labworkflow;Username=postgres;******"
    */
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
